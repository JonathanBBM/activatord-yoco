# Add these in Vercel → activatord-yoco → Settings → Environment Variables.
# Never commit real values.

# --- Already there ---
YOCO_SECRET_KEY=sk_live_xxx

# --- Yoco webhook (printed once by: node scripts/register-webhooks.js yoco) ---
YOCO_WEBHOOK_SECRET=whsec_xxx

# --- Bob Go ---
BOBGO_API_KEY=xxx                 # Andre's key (rotate it — it was sent by email)
BOBGO_ENV=production              # or "sandbox" while testing (needs a sandbox account + key)
BOBGO_ENABLED=true                # set "false" to pause pushing orders without redeploying code
BOBGO_WEBHOOK_SECRET=xxx          # from Bob Go settings, needed for the shipped notification
# BOBGO_CHANNEL_IDENTIFIER=activatord.store   # only if Bob Go says the key belongs to a sales channel

# --- "Your order is on its way" notification ---
# bobgo   = Bob Go sends its own tracking email/WhatsApp (default, no Systeme setup)
# systeme = tag the buyer in Systeme.io and let an automation send your own email
# off     = no notification
SHIPPED_NOTIFY=bobgo

# Only needed when SHIPPED_NOTIFY=systeme
SYSTEME_API_KEY=xxx
SYSTEME_SHIPPED_TAG=order-shipped
SYSTEME_FIELD_TRACKING_NUMBER=tracking_number
SYSTEME_FIELD_TRACKING_URL=tracking_url

ORDER_PREFIX=ACT-
